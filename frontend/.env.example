# Копировать в frontend/.env (не коммитится — см. frontend/.gitignore).
# VITE_* переменные попадают в браузер: секреты здесь хранить нельзя.

# Базовый URL backend (FastAPI). Локально: docker compose up --build из корня репозитория.
VITE_API_BASE_URL=http://localhost:8000

# Режим чата: "mock" — локальная заглушка для демо/тестов, "live" — реальный backend.
VITE_CHAT_API=mock
