# Copy to .env next to docker-compose.yml and fill in real values.
# docker-compose.yml loads this file via `env_file`.
ENVIRONMENT=docker
CORS_ORIGINS=["*"]
LEADS_DB_PATH=/app/backend/data/leads.db

# Leave empty to store leads without sending them anywhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
LEAD_SEND_ATTEMPTS=3
LEAD_RETRY_BACKOFF_SECONDS=0.5
POLZA_AI_API_KEY=
LLM_MODEL=
