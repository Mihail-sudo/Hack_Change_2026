# Copy to .env next to docker-compose.yml and fill in real values.
# docker-compose.yml loads this file via `env_file`.
ENVIRONMENT=docker
CORS_ORIGINS=["*"]
LEADS_DB_PATH=/app/backend/data/leads.db

# Chat sessions. Use "memory" to run without Redis (sessions die with the process).
SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
SESSION_TTL_SECONDS=3600

# Leave empty to store leads without sending them anywhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
LEAD_SEND_ATTEMPTS=3
LEAD_RETRY_BACKOFF_SECONDS=0.5
# Any OpenAI-compatible API that provides Qwen3.8-27B.
# Polza: https://polza.ai/api/v1
LLM_BASE_URL=https://polza.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=BAAI/bge-m3
LLM_TIMEOUT_SECONDS=8
LLM_MAX_ATTEMPTS=2
