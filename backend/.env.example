# Скопируйте в backend/.env или .env в корне репозитория.
# Без ключа backend работает в демо-режиме на материалах базы знаний.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30

# Необязательные настройки
ENVIRONMENT=development
MAX_HISTORY_MESSAGES=12
RETRIEVAL_TOP_K=3
