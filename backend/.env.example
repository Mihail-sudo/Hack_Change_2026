ENVIRONMENT=local
CORS_ORIGINS=["*"]

# SQLite for incoming leads (relative to the process working directory)
LEADS_DB_PATH=backend/data/leads.db

# Telegram delivery. Leave empty to store leads without sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=10
LEAD_SEND_ATTEMPTS=3
LEAD_RETRY_BACKOFF_SECONDS=0.5
